#!/bin/bash

# Path to your python script in /opt
AGENT_SCRIPT="$HOME/opt/git_commit_agent.py"

# Get the absolute path of the current working directory
CURRENT_REPO=$(pwd)

# Execute python script through shebang command
echo "$AGENT_SCRIPT --repo \"$CURRENT_REPO\" --push $*"
"$AGENT_SCRIPT" --repo "$CURRENT_REPO" --push "$@"
