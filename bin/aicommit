#!/bin/bash
#
# aicommit - Fast AI-driven git commit & push CLI powered by Antigravity
#
# Usage:
#   aicommit [custom instructions...]
#   aicommit -h | --help
#
# Examples:
#   # Run with default prompt ("add, commit and push changes"):
#   aicommit
#
#   # Extend default prompt with additional instruction:
#   aicommit "do not push to origin"
#   -> Prompt: "add, commit and push changes. do not push to origin"
#
#   # Pass unquoted custom instructions:
#   aicommit split into two commits for docs and src
#   -> Prompt: "add, commit and push changes. split into two commits for docs and src"

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
  cat << 'EOF'
Usage: aicommit [custom instructions...]

Non-interactively stages, commits, and pushes changes using Antigravity
with low reasoning effort and real-time formatted tool streaming.

Options:
  -h, --help    Show this help message

Default prompt:
  "add, commit and push changes"

Custom instructions are automatically appended to the default prompt:
  aicommit "do not push"
  -> "add, commit and push changes. do not push"

  aicommit split into separate commits for docs and code
  -> "add, commit and push changes. split into separate commits for docs and code"
EOF
  exit 0
fi

BASE_PROMPT="add, commit and push changes"

if [ -n "$*" ]; then
  PROMPT="${BASE_PROMPT}. $*"
else
  PROMPT="${BASE_PROMPT}"
fi

agy -p "$PROMPT" --model gemini-3.7-flash --effort low --output-format stream-json | python3 -c '
import sys, json

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        data = json.loads(line)
        event = data.get("event")
        if event == "step_update":
            su = data.get("step_update", {})
            stype = su.get("step_type")
            state = su.get("state")
            if stype == "tool":
                tname = su.get("tool_name") or su.get("tool_info", {}).get("name", "tool")
                params = su.get("tool_info", {}).get("parameters", {})
                if state == "ACTIVE":
                    cmd = params.get("CommandLine") or params.get("Prompt") or str(params)
                    print(f"\033[36m⚡ [{tname}]\033[0m {cmd}", flush=True)
                elif state == "DONE":
                    out = su.get("tool_info", {}).get("output")
                    if out:
                        for l in out.strip().splitlines()[:10]:
                            print(f"   \033[90m{l}\033[0m", flush=True)
            elif stype == "agent_response":
                delta = su.get("text_delta")
                if delta:
                    print(delta, end="", flush=True)
    except Exception:
        pass
'
