#!/bin/bash

set -euo pipefail

# aicommit - Fast AI-driven git commit & push CLI powered by Codex
#
# Usage:
#   aicommit [custom instructions...]
#   aicommit -h | --help
#
# Examples:
#   # Run with default prompt ("add, commit and push changes"):
#   aicommit
#
#   # Extend default prompt with additional instruction:
#   aicommit "do not push to origin"
#   -> Prompt: "add, commit and push changes. do not push to origin"
#
#   # Pass unquoted custom instructions:
#   aicommit split into two commits for docs and src
#   -> Prompt: "add, commit and push changes. split into two commits for docs and src"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
  cat << 'EOF'
Usage: aicommit [custom instructions...]

Non-interactively stages, commits, and pushes changes using Codex
(gpt-6-luna, medium reasoning effort), with a live activity feed.
Full session output is saved to a private log shown when the run finishes.
New commits are shown with file statistics, then opened for interactive review.
Review: arrows to select, Enter for the full diff, q to return, Esc to close.
Requires codex, uv, fzf and less; uv installs the display dependency automatically.

Options:
  -h, --help    Show this help message

Default prompt:
  "add, commit and push changes"

Custom instructions are automatically appended to the default prompt:
  aicommit "do not push"
  -> "add, commit and push changes. do not push"

  aicommit split into separate commits for docs and code
  -> "add, commit and push changes. split into separate commits for docs and code"
EOF
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --script "${SCRIPT_DIR%/bin}/opt/git_commit_agent.py" "$@"
