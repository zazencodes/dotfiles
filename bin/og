#!/bin/zsh
# ==============================================================================
# HISTORICAL CONTEXT:
# This script (`og` — "organize") was used in the 2024 ZazenCodes Obsidian
# Zettelkasten workflow featured on the ZazenCodes YouTube channel (video:
# "Zettelkasten for programmers").
#
# It automatically parsed YAML tags from notes in `zettelkasten/` and moved them
# into corresponding `notes/<tag>/` subdirectories.
#
# DISABLED IN 2026:
# The ZazenCodes vault has been retired and migrated to AzathHouse. Unstructured
# note intake is now ingested directly into AzathHouse (`inbox/` or `Daily/`)
# and organized autonomously by coding agents (such as the daily-note-review
# agent and Pi vault steward).
# ==============================================================================

echo "Notice: 'og' was disabled in 2026 as part of the AzathHouse migration."
echo "Note organization is now handled by coding agents in AzathHouse."
exit 0

