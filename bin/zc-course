#!/usr/bin/env bash
set -euo pipefail

SESSION_NAME="agentic-course"
CONTENT_DIR="/Users/alex/pro/zazencodes-content/courses/2026_09_14_agentic_coding_fundamentals"
COURSE_CODE_DIR="/Users/alex/pro/agentic-coding-fundamentals-course"
VAULT_NOTES_DIR="/Users/alex/obsidian/AzathHouse/Projects/ZazenCodes/Offers & Products/Courses/Agentic Coding Fundamentals"

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  tmux new-session -d -s "$SESSION_NAME" -n "content" -c "$CONTENT_DIR"
  tmux new-window -t "$SESSION_NAME" -n "vault-notes" -c "$VAULT_NOTES_DIR"
  tmux new-window -t "$SESSION_NAME" -n "course-code" -c "$COURSE_CODE_DIR"
  tmux select-window -t "$SESSION_NAME:content"
fi

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$SESSION_NAME"
else
  exec tmux attach-session -t "$SESSION_NAME"
fi
