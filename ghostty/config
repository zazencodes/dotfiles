# ~/.config/ghostty/config

# Set theme
# theme = Dracula+

# Custom theme ~/.config/ghostty/themes/dracula-plus-custom
# - slightly modified version of the (original dracula theme)[https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Dracula%2B]
theme = dracula-plus-custom

# Font
font-family = DejaVuSansM Nerd Font Mono
font-size = 16

# Window Configuration
title = " "
macos-titlebar-proxy-icon = hidden
window-padding-x = 5
window-padding-y = 0
window-width = 250
window-height = 90
macos-option-as-alt = true

# Emulate previous Terminfo to maintain Neovim/Tmux compatibility
term = xterm-256color

# Cursor shaders (turned on)
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = always

# Action Keybindings
keybind = ctrl+f=toggle_fullscreen
keybind = cmd+q=ignore

# Custom Escape Sequences
keybind = cmd+r=text:\x1b[CmdR~
keybind = cmd+s=text:\x1b[CmdS~
# tmux-agent-plane: previous/next agent (tmux C-M-k / C-M-j)
keybind = ctrl+shift+k=text:\x1b\x0b
keybind = ctrl+shift+j=text:\x1b\x0a
# tmux-agent-plane: into/out of the sidebar (tmux C-M-h / C-M-l)
keybind = ctrl+shift+h=text:\x1b\x08
keybind = ctrl+shift+l=text:\x1b\x0c
